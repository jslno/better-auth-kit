{
	"name": "@better-auth-kit/file-storage",
	"version": "0.1.0",
	"description": "Manage uploading, deleting, or downloading files from a file storage service.",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"keywords": [
		"better-auth",
		"auth",
		"plugin",
		"file",
		"storage",
		"upload",
		"download",
		"delete",
		"better-auth-kit",
		"kit"
	],
	"license": "MIT",
	"author": "better-auth-kit",
	"files": ["./dist/**/*"],
	"scripts": {
		"build": "bun build.ts",
		"dev": "bun build-dev.ts",
		"test": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@remix-run/multipart-parser": "^0.11.0",
		"dotenv": "^16.5.0",
		"zod": "^3.24.2"
	},
	"peerDependencies": {
		"better-auth": "^1.1.21",
		"@aws-sdk/client-s3": "^3.864.0",
		"@aws-sdk/lib-storage": "^3.864.0",
		"uploadthing": "^6.13.3"
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "^3.864.0",
		"@aws-sdk/lib-storage": "^3.864.0",
		"uploadthing": "^6.13.3",
		"@better-auth-kit/internal-build": "workspace:*",
		"@better-auth-kit/tests": "workspace:*",
		"vitest": "^3.0.8"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"default": "./dist/client.js"
		},
		"./provider/aws-s3": {
			"types": "./dist/providers/aws-s3.d.ts",
			"default": "./dist/providers/aws-s3.js"
		},
		"./provider/uploadthing": {
			"types": "./dist/providers/uploadthing.d.ts",
			"default": "./dist/providers/uploadthing.js"
		}
	},
	"publishConfig": {
		"access": "public"
	}
}
